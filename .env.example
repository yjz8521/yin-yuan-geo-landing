# Public site URL (used in metadata / OG / sitemap). Vercel: set to https://<project>.vercel.app
# GitHub Pages default:
NEXT_PUBLIC_SITE_URL=https://yjz8521.github.io/yin-yuan-geo-landing

# Path prefix for GitHub project Pages only. Leave empty for Vercel / local root.
# Pages rebuild: BASE_PATH=/yin-yuan-geo-landing and NEXT_PUBLIC_BASE_PATH=/yin-yuan-geo-landing
BASE_PATH=
NEXT_PUBLIC_BASE_PATH=

# Live geo-platform app URL. Leave empty until deployed — landing will not invent a demo URL.
NEXT_PUBLIC_APP_URL=

# Lemon Squeezy checkout overrides (defaults hardcoded in src/lib/site.ts). Stripe unsupported in Taiwan.
NEXT_PUBLIC_CHECKOUT_STARTER=
NEXT_PUBLIC_CHECKOUT_PRO=

# Demo request mailbox
NEXT_PUBLIC_DEMO_EMAIL=yjz8521@gmail.com

# Public site URL (canonical / hreflang / JSON-LD / sitemap / llms.txt). No trailing slash.
# Default: https://yin-yuan-geo.pages.dev (Cloudflare Pages). Change when you move to your own domain.
NEXT_PUBLIC_SITE_URL=https://yin-yuan-geo.pages.dev

# Path prefix for GitHub project Pages only. Leave empty for Cloudflare / Vercel / local root.
BASE_PATH=
NEXT_PUBLIC_BASE_PATH=

# Live geo-platform app URL. Leave empty until deployed — landing will not invent a demo URL.
NEXT_PUBLIC_APP_URL=

# Lemon Squeezy checkout overrides (defaults hardcoded in src/lib/site.ts). Stripe unsupported in Taiwan.
NEXT_PUBLIC_CHECKOUT_STARTER=
NEXT_PUBLIC_CHECKOUT_PRO=
NEXT_PUBLIC_CHECKOUT_PRO_QUARTERLY=

# Contact mailbox (default yjz8521@gmail.com) and IDs shown on /demo/ (defaults in src/lib/site.ts)
NEXT_PUBLIC_DEMO_EMAIL=yjz8521@gmail.com
NEXT_PUBLIC_CONTACT_LINE_ID=
NEXT_PUBLIC_CONTACT_WECHAT_ID=

# Free AI-visibility check: delivery time in working days (default 2)
NEXT_PUBLIC_CHECK_DELIVERY_DAYS=

# Online forms on /demo/ (health check + demo booking). Default endpoint in src/lib/site.ts.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
